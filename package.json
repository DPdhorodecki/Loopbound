{
  "name": "loopbound",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "icons": "vite-node scripts/gen-icons.ts",
    "sprite": "vite-node scripts/preview.ts",
    "tighten": "vite-node scripts/tighten.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "server": "tsx watch server/index.ts",
    "server:start": "tsx server/index.ts",
    "server:typecheck": "tsc -p server/tsconfig.json"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "express": "^4.21.2",
    "p5": "^1.11.3",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/p5": "^1.7.6",
    "@types/pg": "^8.11.10",
    "pngjs": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.5"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
