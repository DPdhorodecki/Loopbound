# Copie para .env e ajuste. Nunca comite o .env.

# PostgreSQL local (docker compose sobe na 5432)
DATABASE_URL=postgres://loopbound:loopbound@localhost:5432/loopbound

# Use 1 quando o banco exigir SSL (Neon, Render etc.)
DATABASE_SSL=0

# Origens liberadas no CORS, separadas por vírgula. Use * em testes.
APP_ORIGIN=http://localhost:5173,http://localhost:4173

# Porta da API
PORT=3001
